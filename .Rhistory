phyloseq.birth.study_fixed <- tax_fix(phyloseq.birth.study)
######ANSWERS TO SECTION 8####
#To access these samples, we need to get a phyloseq object of samples from this birth study
phyloseq.birth.study <- subset_samples(phyloseq.dogs, birthstudy == "yes")
#from here, you can use the puppies_mode_of_delivery column for comparison
phyloseq.birth.study_fixed <- tax_fix(phyloseq.birth.study)
comp_barplot(phyloseq.birth.study, tax_level = "species", group_by = "puppies_mode_of_delivery", n_taxa = 14)
#High levels of L johnsonii in Cesearean not Vaginal
rarefied.phyloseq.birth.study <- rarefy_even_depth(phyloseq.birth.study, sample.size = min(sample_sums(phyloseq.birth.study)))
plot_richness(rarefied.phyloseq.birth.study, x="puppies_mode_of_delivery", measures= c("Observed")) + geom_boxplot()
bray.distance.puppies.birthstudy <- phyloseq::distance(rarefied.phyloseq.birth.study, method = "bray")
pcoa.ord.puppies.birthstudy <- phyloseq::ordinate(rarefied.phyloseq.birth.study, method ="PCoA", distance = bray.distance.puppies.birthstudy)
plot_ordination(rarefied.phyloseq.birth.study, pcoa.ord.puppies.birthstudy, color = "puppies_mode_of_delivery")
